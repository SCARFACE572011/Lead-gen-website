# Google Places API key — get from https://console.cloud.google.com/
# Enable "Places API" in the Cloud Console, then paste the key here.
# Rename this file to .env.local to activate Google Places scraping.
GOOGLE_PLACES_API_KEY=your_key_here

# Server-only billing / entitlement configuration. Never prefix these with
# NEXT_PUBLIC and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_your_pro_annual
STRIPE_PRICE_AGENCY_MONTHLY=price_your_agency_monthly
STRIPE_PRICE_AGENCY_ANNUAL=price_your_agency_annual

# Email Finder provider. Credit-pack sales stay off until the provider has
# approved LeadZipp's embedded/resale use in writing.
HUNTER_API_KEY=your_key_here
EMAIL_CREDIT_PACKS_ENABLED=false
STRIPE_PRICE_EMAIL_CREDITS_50=
STRIPE_PRICE_EMAIL_CREDITS_250=
STRIPE_PRICE_EMAIL_CREDITS_1000=
